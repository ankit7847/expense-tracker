# Server Port (Render sets this dynamically via PORT env variable)
PORT=3000

# Google Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for User Authentication Tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_12345

# Database Configuration (Optional)
# If provided, connects to MongoDB Atlas.
# If omitted or left blank, automatically uses local zero-setup SQLite (data/expense_tracker.sqlite).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/expense_tracker?retryWrites=true&w=majority
